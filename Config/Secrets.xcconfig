// TRACKED. Do not put a real token in this file — this repository is public.
//
// The empty default below is what a fresh clone builds with: the app works,
// essay grading reports itself unconfigured. To enable grading locally, create
// Config/Secrets.local.xcconfig (gitignored) containing:
//
//     GRADER_PROXY_TOKEN = <the Cloudflare PROXY_TOKEN secret>
//
// Avoid "/" in the value: xcconfig treats "//" as a comment and would silently
// truncate it, giving a wrong-but-non-empty token and a baffling 401.
GRADER_PROXY_TOKEN =

// Optional include — the "?" means a missing file is not an error, which is
// what keeps a fresh clone building.
#include? "Secrets.local.xcconfig"
